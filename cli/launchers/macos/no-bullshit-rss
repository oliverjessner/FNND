#!/bin/sh

set -eu

# Resolve symlinks so this launcher keeps working when linked into /usr/local/bin.
SOURCE=$0
while [ -h "$SOURCE" ]; do
    SOURCE_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE")" && pwd)
    LINK_TARGET=$(readlink "$SOURCE")
    case "$LINK_TARGET" in
        /*) SOURCE=$LINK_TARGET ;;
        *) SOURCE=$SOURCE_DIR/$LINK_TARGET ;;
    esac
done

LAUNCHER_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE")" && pwd)
RESOURCES_DIR=$(CDPATH= cd -- "$LAUNCHER_DIR/.." && pwd)
CONTENTS_DIR=$(CDPATH= cd -- "$RESOURCES_DIR/.." && pwd)
ELECTRON_BIN="$CONTENTS_DIR/MacOS/NO BULLSHIT RSS"
CLI_ENTRY="$RESOURCES_DIR/app.asar/cli/no-bullshit-rss.js"

if [ ! -x "$ELECTRON_BIN" ]; then
    printf 'Error: NO BULLSHIT RSS executable not found at %s\n' "$ELECTRON_BIN" >&2
    exit 1
fi

if [ ! -f "$RESOURCES_DIR/app.asar" ]; then
    printf 'Error: NO BULLSHIT RSS application archive not found at %s\n' "$RESOURCES_DIR/app.asar" >&2
    exit 1
fi

ELECTRON_RUN_AS_NODE=1 exec "$ELECTRON_BIN" "$CLI_ENTRY" "$@"
